# Copia este archivo a .env.local para desarrollo. En Vercel se configuran en
# Settings → Environment Variables (ver README, sección "Dossieres rastreables").

# Upstash Redis (los crea Vercel al conectar Upstash desde Storage → Marketplace).
# Si el Marketplace los crea con prefijo KV_ (KV_REST_API_URL / KV_REST_API_TOKEN)
# también se reconocen. Sin estas variables la web sigue sirviendo los PDF,
# pero las aperturas solo se guardan en memoria (se pierden al reiniciar).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Token de acceso al panel /admin/aperturas y a /api/opens. Cadena larga aleatoria.
ADMIN_TOKEN=

# Sal para hashear las IP de las aperturas (nunca se guardan en claro). Cadena aleatoria.
IP_SALT=

# Stories de Instagram (conector privado, ver README → "Stories de Instagram").
# Token largo de la app "Aquila Stories" en Meta for Developers (60 días).
IG_ACCESS_TOKEN=
# ID de la cuenta profesional de Instagram (@aquilasportsm).
IG_USER_ID=17841471503444352
# Cadena aleatoria de 32+ caracteres: va en la URL del conector (/api/mcp/<CONNECTOR_KEY>). No compartir.
CONNECTOR_KEY=
